CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# --- Add Tailscale ---
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y

# Ensure TUN driver is enabled (Required for VPNs)
CONFIG_PACKAGE_kmod-tun=y

# Ensure HTTPS certificates are present (Required for Tailscale login)
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y

#
# --- REMOVED PACKAGES (Ensure these are NOT set) ---
#
# CONFIG_PACKAGE_coreutils is not set
# CONFIG_PACKAGE_coreutils-base64 is not set
